{
  "name": "falp-slide-builder",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "imports": {
    "#modules/*": {
      "types": "./src/modules/*/index.ts",
      "development": "./src/modules/*/index.ts",
      "default": "./dist/modules/*/index.js"
    },
    "#shared/*": {
      "types": "./src/shared/*.ts",
      "development": "./src/shared/*.ts",
      "default": "./dist/shared/*.js"
    }
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "build": "tsc -p tsconfig.build.json && vite build --config studio/vite.config.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "dev": "pnpm run build && pnpm run --parallel \"/^dev:/\"",
    "dev:tsc": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "dev:server": "node --watch dist/server.js",
    "studio:dev": "vite --config studio/vite.config.ts",
    "studio:build": "vite build --config studio/vite.config.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/static": "8.3.0",
    "fastify": "5.12.7",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.6.3",
    "@playwright/test": "1.57.0",
    "@types/node": "24.19.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "5.0.5",
    "typescript": "5.9.3",
    "vite": "8.0.13",
    "vitest": "5.0.5"
  },
  "description": "Personal presentation-builder project: initial Fastify backend foundation; not an institutional FALP product."
}
